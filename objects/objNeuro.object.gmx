          <argument>
            <kind>1</kind>
            <string>if (live_call()) return live_result;
global.noPause = true;
t = global.tStart;
delta_t = 0;
deltaCount = 0;
scrStopMusic();
scrPlayMusic(musNeuro,false);
screenAlpha = 0;
flashAlpha = 0;
easing_t = 0;
blowAmount = irandom_range(1,2);
bounceAmount = irandom_range(1,2);
xIc = 48;
tModRandom = 11;
scaleRandom = random_range(0.35,0.75);
flashInd = 1;
sqTag = 0;
sqSlow = true;
