        <arguments>
          <argument>
            <kind>1</kind>
            <string>//put this shit at the end always
draw_set_alpha(screenAlpha);
draw_set_color(c_black);
draw_rectangle(view_xview[0],view_yview[0],view_xview[0]+view_wview[0],view_yview[0]+view_hview[0],false);

draw_sprite_ext(sprFlashBorder,0,view_xview[0],view_yview[0],view_wview[0]/800,view_hview[0]/608,0,c_white,flashAlpha);

draw_set_alpha(1); //especially this
</string>
