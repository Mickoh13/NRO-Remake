        <arguments>
          <argument>
            <kind>1</kind>
            <string>global.noPause = true;
t = global.tStart;
delta_t = 0;
deltaCount = 0;
scrStopMusic();
scrPlayMusic(musNeuro,false);
screenAlpha = 0;
flashAlpha = 0;
easing_t = 0;

if (t == 0)
{
screenAlpha = 1;
view_xview[0] = 100;
view_yview[0] = 80;
view_wview[0] = 600;
view_hview[0] = 456;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///standard things
if !(instance_exists(objPlayer))
{
scrStopMusic();
exit;
}
else
{
t++;
delta_t += 50 * delta_time / 1000000;
}

if t &gt; 0
{
deltaCount = delta_t - t;
if abs(deltaCount) &gt; 5
    {
    audio_sound_set_track_position(global.currentMusic,t/50);
    delta_t = t;
    }
}

if flashAlpha &gt; 0
flashAlpha = max(flashAlpha-0.04,0);
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///1. First things first
if t &gt; 7 &amp;&amp; t &lt; 95
{
easing_t = min(easing_t+1,88);
if t &gt; 22
screenAlpha = max(screenAlpha-(1/70),0.25);
view_xview[0] = scrEaseInOutCubic(easing_t,88,100,0,true);
view_yview[0] = scrEaseInOutCubic(easing_t,88,80,0,true);
view_wview[0] = scrEaseInOutCubic(easing_t,88,600,800,true);
view_hview[0] = scrEaseInOutCubic(easing_t,88,456,608,true);
}

if (t &gt; 21 &amp;&amp; t &lt; 580 &amp;&amp; ((t-20) mod 40) = 0) || t = 20
{
repeat(irandom_range(1,4))
{
aBounce = instance_create(400,304,objCherryBounce);
aBounce.direction = random(360);
aBounce.speed = random(0.1);
if t &lt; 94
aBounce.alarm[0] = irandom_range(1,10);
}
}

if t = 94
{
screenAlpha = 0
flashAlpha = 0.5;
{
with objCherryBounce
{
alarm[0] = 0;
speed += random_range(4,8);
angleAdd = angleAdd * random_range(1.1,1.375);
aCopy = instance_create(x,y,objCherryBounce);
aCopy.direction = direction + 180;
aCopy.speed = speed;
aCopy.image_angle = image_angle;
aCopy.image_alpha = 1
aCopy.angleAdd = -angleAdd;
}
with objCherry
{
speed = speed * 2;
direction += random_range(-10,10);
}
}
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
