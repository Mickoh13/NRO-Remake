        <arguments>
          <argument>
            <kind>1</kind>
            <string>///4. Assault

if t = 2327
{
repeat(90)
{
a360 = instance_create(400,168,objCherry);
a360.direction = random(360);
a360.speed = random_range(6,12);
a360.image_xscale = random_range(0.5,1);
a360.image_yscale = a360.image_xscale;
a360.gravity_direction = 270;
a360.gravity = random_range(0.075,0.1);
a360.depth = 9.5;
a360.glow = true;
}
}

if t &gt; 2347 &amp;&amp; (t mod 8) = 0 &amp;&amp; t &lt; 3148
{
aLeehotic = instance_create(choose(random_range(-60,-40),random_range(860,890)),random_range(48,560),objCherryAssault);
aLeehotic.gravity = leGrov;
aLeehotic.gravity_direction = leGrovDir;
}

if t = 2365
with objUkraineCherry
doTrails = false;

if t = 2397 || t = 2467 || t = 2537 || t = 2607 || t = 2677
switchAngle = switchAngle * -1;

if (t &gt; 2327 &amp;&amp; t &lt; 2347) || (t &gt; 2467 &amp;&amp; t &lt; 2487) || (t &gt; 2607 &amp;&amp; t &lt; 2627) || (t &gt; 2902 &amp;&amp; t &lt; 2932) || (t &gt; 3029 &amp;&amp; t &lt; 3060)
invertScale = lerp(invertScale,3,0.02);

if (t &gt; 2397 &amp;&amp; t &lt; 2467) || (t &gt; 2537 &amp;&amp; t &lt; 2607) || (t &gt; 2677 &amp;&amp; t &lt; 2747) || (t &gt; 2954 &amp;&amp; t &lt; 3024) || (t &gt; 3098 &amp;&amp; t &lt; 3160)
invertScale = lerp(invertScale,0,0.125);

if t = 2571
switchAngle = choose(-1,1);

if t = 2541
{
with objCherryAssault
{
gravity = random_range(0.1,0.25);
gravity_direction = random_range(265,275);
}
}

if t = 2747
{
leGrov = 0.2;
leGrovDir = 90;
with objCherryAssault
{
gravity = 0.2;
gravity_direction = 90;
}
}

if t = 2817 || t = 3098
{
leGrov = 0.15;
leGrovDir = 270;
with objCherryAssault
{
gravity = 0.15;
gravity_direction = 270;
}
}

if t = 2880
{
leGrov = 0;
leGrovDir = 0;
}
if (t &gt; 2747 &amp;&amp; t &lt;= 2885)
{
if ((t-2748) mod 3) = 0 &amp;&amp; t &lt; 2830
{
spiralDire = random(360);
for(var ij = 0; ij &lt; 360; ij += 180)
{
aWhat = instance_create(400,168,objCherrySpiral);
aWhat.aDir = ij + spiralDire;
aWhat.aCurve = -1.5
}
spiralDire = random(360);
for(var ji = 0; ji &lt; 360; ji += 180)
{
aWhat = instance_create(400,168,objCherrySpiral);
aWhat.aDir = ji + spiralDire + 90;
aWhat.aCurve = 1.5;
}
}
invertScale += invertAdd;
if ((t-2754) mod 6) = 0 &amp;&amp; t &lt; 2817
{
invertTag++;
with objInvert
{
kak = other.invertTag;
scaleGet[other.invertTag] = objNeuro.invertScale;
}
}
}

if t &gt; 2797 &amp;&amp; t &lt; 2817
{
invertAdd = max(invertAdd-0.0019,0)
}

if t &gt;= 2817 &amp;&amp; t &lt;= 2887
invertAdd -= 0.000885;

if t = 2886
{
with objInvert
{
kak = 1;
}
}

if t = 2883
{
repeat(irandom_range(130,170))
{
a360 = instance_create(400,168,objCherry);
a360.direction = random(360);
a360.speed = random_range(0.25,12);
a360.image_xscale = random_range(0.4,0.95);
a360.image_yscale = a360.image_xscale;
a360.depth = 9.5;
a360.glow = true;
a360.dirCur = choose(-1,1);
a360.curvePoint = true;
}
}
</string>
