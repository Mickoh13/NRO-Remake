view_yview[0] = scrEaseInOutCubic(easing_t,88,80,0,true);
view_wview[0] = scrEaseInOutCubic(easing_t,88,600,800,true);
view_hview[0] = scrEaseInOutCubic(easing_t,88,456,608,true);
}

if ((t &gt; 9 &amp;&amp; t &lt; 238) || (t &gt; 375 &amp;&amp; t &lt; 517)) &amp;&amp; ((t-9) mod 30) = 0 || t = 9
{
if t &lt; 443
bounceAmount = irandom_range(1,2);
else
bounceAmount = irandom_range(3,4);
repeat(irandom_range(1,2))
{
