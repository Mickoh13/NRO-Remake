        <arguments>
          <argument>
            <kind>1</kind>
            <string>///3. Pre-Assault
if t = 1766
{
flashInd = 0;
with objUkraineMain
{
alarm[0] = 1;
state = 0;
}
}

if t &gt; 1766 &amp;&amp; t &lt; 1966
flashAlpha = 0.1+abs(0.2*dsin((t-1766)*10));
if t &gt; 1976 &amp;&amp; t &lt; 2047
flashAlpha = lerp(0,0.5,dsin((t-1976)*(90/71)));

if t = 2047
{
flashSub = 0.065;
with objUkraineMain
{
for(var i = 0; i &lt; 360; i += 180)
{
aSpray = instance_create(x,y,objCherrySpray3);
aSpray.direction = i;
aSpray.speed = 13;
}
alarm[0] = 0;
state = -1;
}
}

if t &gt; 2047 &amp;&amp; t &lt; 2183 &amp;&amp; ((t-2047) mod 7) = 0 &amp;&amp; !(t = 2116)
{
for (var jj = 0; jj &lt; 360; jj += 90)
{
aUkraine = instance_create(400+(global.UkrXX[jj/90]),168+(global.UkrYY[jj/90]),objUkraineCherry);
aUkraine.direction = jj + ukraineAng;
aUkraine.speed = 6;
aUkraine.friction = 1;
aUkraine.cherryInd = jj/90;
aUkraine.alarm[0] = 6;
}
}

if t = 2117
ukraineAng -= 90;

if t &gt; 2047 &amp;&amp; (t mod 6) = 0 &amp;&amp; t &lt; 2186
flashAlpha = 0.35;

if t = 2047
flashSub = 0.06;

if t = 2186
{
flashSub = 0.13;
with objCherrySpray3
{
alTime = 1;
friction = -0.4;
}
with objUkraineCherry
{
nLength = point_distance(400,168,x,y);
nDir = point_direction(400,168,x,y);
active = true;
}
}

if t = 2194
{
with objUkraineCherry
doTrails = true;
}

if t &gt; 2186 &amp;&amp; (t mod 3) = 0 &amp;&amp; t &lt; 2256
flashAlpha = 0.425;

if t = 2256
{
global.spikeInd = irandom(11);
instance_destroy(objCherrySpray3);
with objNeuroBlock
{
blackAlpha = 1;
alpha = 1;
}
}

if t = 2307
{
with objCherrySpike
alarm[0] = irandom_range(1,18);
}

if t &gt; 2290 &amp;&amp; t &lt; 2311
{
with objNeuroBlock
blackAlpha = max(blackAlpha-0.05,0);
background_alpha[1] = min(background_alpha[1]+0.02,0.2);
}

if t = 2320
instance_create(0,0,objInvert);
</string>
          </argument>
